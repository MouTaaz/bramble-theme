

{%- capture wrapper_class -%}quantity-selector-wrapper--block-{{ block.id }}{%- endcapture -%}
{% style %}
  .{{ wrapper_class }} {
    --quantity-selector-width-custom: {{ block.settings.selector_width | default: 124 }}px;
  }
{% endstyle %}

{% render 'quantity-selector', product: closest.product, block: block, wrapper_class: wrapper_class %}

{% schema %}
{
  "name": "t:names.quantity",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "selector_width",
      "label": "Quantity selector width",
      "min": 0,
      "max": 50,
      "step": 4,
      "unit": "px",
      "default": 124
    }
  ],
  "presets": [
    {
      "name": "t:names.quantity",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

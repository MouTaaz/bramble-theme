{% comment %}
  Variant Picker — Radio Button Pills
  Usage: {% render 'variant-picker', product: product, section_id: section.id %}

  Renders native HTML radio buttons styled as pills.
  The shared variant-picker component handles variant resolution and events.
{% endcomment %}

{%- unless product.has_only_default_variant -%}
  <variant-picker
    class="featured-product__variants"
    data-section-id="{{ section_id }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product.url }}"
  >
    {%- for option in product.options_with_values -%}
      <fieldset
        class="featured-product__variant-group"
        data-fieldset-index="{{ forloop.index0 }}"
        ref="fieldsets[]"
      >
        <legend class="featured-product__variant-label">{{ option.name | escape }}</legend>
        <div class="featured-product__variant-options">
          {%- for value in option.values -%}
            <div class="featured-product__variant-option">
              <input
                type="radio"
                id="Option-{{ section_id }}-{{ option.position }}-{{ forloop.index0 }}"
                name="options[{{ option.name | escape }}]"
                value="{{ value | escape }}"
                class="featured-product__variant-input"
                data-fieldset-index="{{ forloop.parentloop.index0 }}"
                data-option-position="{{ option.position }}"
                data-option-value="{{ value | escape }}"
                data-input-index="{{ forloop.index0 }}"
                data-option-name="{{ option.name | escape }}"
                data-option-value-id="{{ value.id }}"
                {% if value.variant != blank %}
                  data-variant-id="{{ value.variant.id }}"
                {% endif %}
                data-option-available="{{ value.available }}"
                {% if option.selected_value == value %}
                  data-current-checked="true"
                  checked
                {% else %}
                  data-current-checked="false"
                {% endif %}
              >
              <label
                for="Option-{{ section_id }}-{{ option.position }}-{{ forloop.index0 }}"
                class="featured-product__variant-pill"
              >
                {{ value | escape }}
              </label>
            </div>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
    <script type="application/json">
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-picker>
{%- endunless -%}
